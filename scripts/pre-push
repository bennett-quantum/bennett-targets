#!/usr/bin/env bash
set -euo pipefail
root="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
unset DISPLAY WAYLAND_DISPLAY DBUS_SESSION_BUS_ADDRESS BROWSER
export TMPDIR="$root/.tmp"
mkdir -p "$TMPDIR"
cargo fmt --manifest-path "$root/validator/Cargo.toml" -- --check
cargo clippy --offline --manifest-path "$root/validator/Cargo.toml" --all-targets -- -D warnings
cargo test --offline --manifest-path "$root/validator/Cargo.toml"
cargo build --offline --manifest-path "$root/validator/Cargo.toml"
python3 "$root/scripts/verify.py"
